SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for local SQLite. For local PostgreSQL/pgAdmin, use a URL such as:
# postgresql://postgres:password@127.0.0.1:5432/aralforge
# Percent-encode special characters in the username or password.
DATABASE_URL=
# Reuse PostgreSQL connections for long-running app servers; use 0 for serverless.
DB_CONN_MAX_AGE=60
# Log API requests slower than this threshold.
API_SLOW_REQUEST_MS=750
# Temporarily enable aggregate database duration/query-count diagnostics. This
# does not log SQL or parameters; leave disabled outside an investigation.
API_DB_TIMING_ENABLED=False

STATIC_URL=/static/
# STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
# Local development only when Supabase S3 variables are not configured.
# MEDIA_ROOT=/var/lib/aralforge/media

# Supabase Storage S3 compatibility. Use a private bucket and server-only keys.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_SIGNED_URL_SECONDS=3600

# Production security overrides (secure defaults are used when DEBUG=False).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
