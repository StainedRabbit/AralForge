SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for local SQLite. Use Supabase/PostgreSQL URL in staging/production.
DATABASE_URL=
# Reuse PostgreSQL connections for long-running app servers; use 0 for serverless.
DB_CONN_MAX_AGE=60
# Log API requests slower than this threshold.
API_SLOW_REQUEST_MS=750

STATIC_URL=static/
# STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
# In staging/production this must be a persistent mounted volume, not ephemeral app storage.
# MEDIA_ROOT=/var/lib/ezoryx/media

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
