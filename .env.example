SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Advanced real-student privacy workflows remain dormant unless separately
# approved and deliberately enabled.
ADVANCED_PRIVACY_FEATURES=False
REAL_STUDENT_PRIVACY_ENFORCEMENT=False
AUTH_REFRESH_COOKIE_NAME=aralforge_refresh
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=None
# Refresh sessions persist for this many inactive days and renew on use.
AUTH_REFRESH_TOKEN_DAYS=90
AUTH_LOGIN_THROTTLE_RATE=10/minute
AUTH_PASSWORD_SETUP_THROTTLE_RATE=6/minute
AUTH_REFRESH_THROTTLE_RATE=30/minute

# Leave empty for local SQLite. For local PostgreSQL/pgAdmin, use a URL such as:
# postgresql://postgres:password@127.0.0.1:5432/aralforge
# Percent-encode special characters in the username or password.
DATABASE_URL=
# Reuse PostgreSQL connections for long-running app servers; use 0 for serverless.
DB_CONN_MAX_AGE=60
# Shared Redis URL used by the API and Celery worker for background imports.
REDIS_URL=
# Allow the supported 1,000-row roster import to finish on a small worker.
CELERY_TASK_TIME_LIMIT=1800
# Fail roster imports that have not been picked up by a worker within 5 minutes.
ROSTER_IMPORT_QUEUE_TIMEOUT_SECONDS=300
# Log API requests slower than this threshold.
API_SLOW_REQUEST_MS=750
# Temporarily enable aggregate database duration/query-count diagnostics. This
# does not log SQL or parameters; leave disabled outside an investigation.
API_DB_TIMING_ENABLED=False

STATIC_URL=/static/
# STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
# Local development only when object storage variables are not configured.
# MEDIA_ROOT=/var/lib/aralforge/media

# Cloudflare R2 S3 compatibility. Use the account endpoint (without a bucket
# path), region auto, a private bucket, and server-only Object Read & Write keys.
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_REGION=auto
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_SIGNED_URL_SECONDS=3600
# Existing deployments may continue using the complete legacy SUPABASE_* set,
# but must not mix it with OBJECT_STORAGE_* variables.

# Production security overrides (secure defaults are used when DEBUG=False).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
